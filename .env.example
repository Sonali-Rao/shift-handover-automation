# ---------------------------------------------------------------
# Shift Handover Mail Automation - configuration
# Copy this file to ".env" and adjust values if needed.
# NEVER put real passwords, client secrets or API keys in this file
# if it is committed to Git. ".env" itself is git-ignored.
# ---------------------------------------------------------------

# Shift end times (24h, HH:MM). Each shift starts when the previous one ends.
MORNING_SHIFT_END=14:30
AFTERNOON_SHIFT_END=22:30
NIGHT_SHIFT_END=06:30
TIMEZONE=Asia/Kolkata

# A ticket open longer than this is an "aging" ticket.
AGING_THRESHOLD_HOURS=24
# A ticket whose SLA is due within this many hours after shift end is "SLA risk".
SLA_RISK_WINDOW_HOURS=2

# Run the handover automatically at every shift end (true/false).
ENABLE_SCHEDULER=true

# Email (mock only for the demo - nothing is really sent).
EMAIL_PROVIDER=mock
EMAIL_FROM=l1-automation@example.com
EMAIL_TO=l1-cloudops@example.com
EMAIL_TO_NAME=L1 Cloud Operations
EMAIL_SIGNATURE=L1 Cloud Operations

# Mock data files
TICKETS_FILE=data/tickets.json
TEAMS_FILE=data/teams_messages.json
